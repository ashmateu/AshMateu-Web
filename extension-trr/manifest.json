{
  "manifest_version": 3,
  "name": "Ash Mateu — The RealReal Curador",
  "version": "1.2",
  "description": "Extrae piezas de archivo y las publica en El Mercadito de Ash con 1 click.",
  "permissions": ["activeTab"],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.therealreal.com/products/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
